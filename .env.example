DATABASE_URL="postgresql://user:password@localhost:5432/lawadvisory?schema=public"
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-strong-random-secret"

# Bootstraps your admin account when you run `npx prisma db seed`.
# Required for the production-safe seed to do anything.
ADMIN_EMAIL="you@yourfirm.com"
ADMIN_NAME="Your Name"
# Optional — a strong random password is generated and printed if omitted.
ADMIN_PASSWORD=""

# Optional: without this, "forgot password" emails are logged to the
# server console instead of actually being sent. Get a key at resend.com.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="portal@yourfirm.com"

# Optional: point this at a mounted Railway Volume path in production —
# container disk is ephemeral otherwise and uploaded documents will be
# lost on every redeploy. Defaults to ./storage/uploads if unset.
STORAGE_DIR=""
